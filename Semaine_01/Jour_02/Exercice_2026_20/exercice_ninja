# 1. Copie de la chaîne de caractères
cars_string = "Volkswagen, Toyota, Ford Motor, Honda, Chevrolet"

# 2. Conversion automatique en liste (en coupant au niveau des virgules et en enlevant les espaces)
manufacturers = [car.strip() for car in cars_string.split(",")]

# 3. Nombre de constructeurs
print(f"There are {len(manufacturers)} manufacturers in the list.")

# 4. Tri de la liste par ordre décroissant (Z-A)
manufacturers_desc = sorted(manufacturers, reverse=True)
print(f"Manufacturers in descending order (Z-A): {manufacturers_desc}")

# 5. Comptage des lettres avec list comprehension
count_with_o = len([name for name in manufacturers if "o" in name.lower()])
count_without_i = len([name for name in manufacturers if "i" not in name.lower()])

print(f"Manufacturers with the letter 'o': {count_with_o}")
print(f"Manufacturers without the letter 'i': {count_without_i}")

# --- BONUS 1 : Supprimer les doublons ---
duplicates_list = ["Honda", "Volkswagen", "Toyota", "Ford Motor", "Honda", "Chevrolet", "Toyota"]
# Utilisation d'un set pour supprimer automatiquement les doublons
unique_companies = list(set(duplicates_list))

# Transformation de la liste en chaîne de texte séparée par des virgules
comma_separated_companies = ", ".join(unique_companies)
print(f"\nBonus 1 - Companies without duplicates: {comma_separated_companies}")
print(f"Bonus 1 - There are now {len(unique_companies)} companies in the list.")

# --- BONUS 2 : Ordre A-Z et inversion des lettres ---
# On trie d'abord par ordre alphabétique (A-Z)
sorted_companies = sorted(unique_companies)
# On inverse les lettres de chaque nom avec l'astuce [::-1]
reversed_names_companies = [name[::-1] for name in sorted_companies]
print(f"Bonus 2 - Alphabetical order with reversed letters: {reversed_names_companies}")


